<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B0F">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1B5E20"
        android:paddingTop="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lupa Password"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atur ulang kata sandi Anda 🔑"
            android:textColor="#A5D6A7"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="#A5D6A7"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etForgotUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Username terdaftar"
                android:inputType="text"
                android:background="@drawable/input_bg"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp" />

            <!-- Nomor HP -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nomor HP / WhatsApp"
                android:textColor="#A5D6A7"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etForgotPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Nomor HP terdaftar (08xxxxxxxxxx)"
                android:inputType="phone"
                android:background="@drawable/input_bg"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp" />

            <!-- Password Baru -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password Baru (min. 6 karakter)"
                android:textColor="#A5D6A7"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Masukkan password baru"
                android:inputType="textPassword"
                android:background="@drawable/input_bg"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp" />

            <!-- Konfirmasi Password Baru -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Konfirmasi Password Baru"
                android:textColor="#A5D6A7"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etConfirmNewPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ulangi password baru"
                android:inputType="textPassword"
                android:background="@drawable/input_bg"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- Tombol Aksi -->
            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔄 Reset Password"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Kembali ke Login -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvBackToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kembali ke Masuk"
                    android:textColor="#43A047"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
