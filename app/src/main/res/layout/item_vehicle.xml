<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="12dp"
    android:layout_marginTop="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- GALERI FOTO (HorizontalScrollView) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/containerFotoBeli"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- BADGE TIPE -->
            <TextView
                android:id="@+id/tvVehicleType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="@drawable/btn_green_rounded"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Mobil"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- TOMBOL FAVORIT ❤ -->
            <ImageButton
                android:id="@+id/btnFavorit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_circle_white"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="Favorit"
                android:elevation="4dp" />

            <!-- BADGE HIGH RISK -->
            <TextView
                android:id="@+id/tvFraudBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:text="⚠️ HIGH RISK"
                android:textColor="#FFFFFF"
                android:background="#CCD32F2F"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- KONTEN BAWAH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- NAMA + TAHUN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvVehicleName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Nama Kendaraan"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:id="@+id/tvVehicleYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2020"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:background="@drawable/search_background"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <!-- RATING -->
            <RatingBar
                android:id="@+id/ratingBarSmall"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="0.5"
                android:rating="4.5"
                android:progressTint="#FFC107"
                android:layout_marginTop="6dp" />

            <!-- HARGA + AI PRICE BADGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvVehiclePrice"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Rp 150.000.000"
                    android:textColor="#2E7D32"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- AI Price Fairness Badge -->
                <TextView
                    android:id="@+id/tvAIPriceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟡 WAJAR"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_green_rounded"
                    android:backgroundTint="#F57F17"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <!-- AI HEALTH SCORE BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvHealthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏥 AI Score"
                    android:textSize="11sp"
                    android:textColor="#555555"
                    android:layout_marginEnd="8dp" />

                <ProgressBar
                    android:id="@+id/pbHealthScore"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="75"
                    android:progressTint="#2E7D32" />

                <TextView
                    android:id="@+id/tvHealthScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- DESKRIPSI SINGKAT -->
            <TextView
                android:id="@+id/tvVehicleDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Keterangan kendaraan..."
                android:textSize="13sp"
                android:textColor="#666666"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- TOMBOL HUBUNGI — 2 pilihan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:baselineAligned="false">

                <!-- WhatsApp -->
                <Button
                    android:id="@+id/btnHubungiPenjual"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="3"
                    android:layout_marginEnd="8dp"
                    android:text="💬 WhatsApp"
                    android:backgroundTint="#25D366"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <!-- Telepon -->
                <Button
                    android:id="@+id/btnTeleponPenjual"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="2"
                    android:text="📞 Telepon"
                    android:backgroundTint="#1976D2"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- LOKASI + TOMBOL MAPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <!-- Badge Kota -->
                <TextView
                    android:id="@+id/tvLokasiKota"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📍 Lokasi tidak tersedia"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:drawablePadding="4dp" />

                <!-- Tombol Google Maps -->
                <Button
                    android:id="@+id/btnLihatMaps"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🗺️ Maps"
                    android:backgroundTint="#FF6F00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Tombol Rating Penjual -->
            <Button
                android:id="@+id/btnRating"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="⭐ Beri Rating Penjual"
                android:backgroundTint="#1A2E1C"
                android:textColor="#FFD600"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="2dp" />

            <!-- Tombol Tawar Harga -->
            <Button
                android:id="@+id/btnTawar"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="🏷️ Tawar Harga"
                android:backgroundTint="#4A148C"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
