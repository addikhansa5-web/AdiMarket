<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:background="#1B5E20"
        android:gravity="bottom"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBackOffers"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="#44FFFFFF"
                android:tint="#FFFFFF"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="🏷️ Kotak Penawaran"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tabOfferMasuk"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="📥 Masuk"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_green_rounded"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tabOfferTerkirim"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="📤 Terkirim"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#388E3C"
            android:background="@drawable/btn_outline_rounded" />
    </LinearLayout>

    <!-- TAB MASUK -->
    <ScrollView
        android:id="@+id/llOffersMasuk"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvEmptyMasuk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📭 Belum ada penawaran masuk.\nPastikan nomor HP Anda terdaftar di profil."
                android:textAlignment="center"
                android:textColor="#888888"
                android:textSize="14sp"
                android:padding="32dp"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/listMasuk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- TAB TERKIRIM -->
    <ScrollView
        android:id="@+id/llOffersTerkirim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvEmptyTerkirim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📭 Belum ada penawaran terkirim.\nTawar kendaraan lewat tombol 🏷️ Tawar Harga di iklan."
                android:textAlignment="center"
                android:textColor="#888888"
                android:textSize="14sp"
                android:padding="32dp"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/listTerkirim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
