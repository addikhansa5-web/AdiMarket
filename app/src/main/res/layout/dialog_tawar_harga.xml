<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏷️ Ajukan Penawaran Harga"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvOfferVehicleName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toyota Avanza 2021"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <!-- Harga Listing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="💰 Harga Iklan:"
            android:textSize="13sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvOfferListPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 185 Jt"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />
    </LinearLayout>

    <!-- Input Harga Tawaran -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📝 Harga Tawaran Anda (Juta Rp):"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etOfferPrice"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Contoh: 175"
        android:inputType="numberDecimal"
        android:background="@drawable/search_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="16sp"
        android:textColor="#111111"
        android:layout_marginBottom="12dp" />

    <!-- Pesan Negosiasi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💬 Pesan ke Penjual (opsional):"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etOfferMessage"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="Saya tertarik, bisa kurang sedikit?"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:background="@drawable/search_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <!-- Nama pembeli -->
    <EditText
        android:id="@+id/etOfferBuyerName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="👤 Nama Anda"
        android:background="@drawable/search_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <!-- No HP pembeli -->
    <EditText
        android:id="@+id/etOfferBuyerPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="📱 No. HP Anda"
        android:inputType="phone"
        android:background="@drawable/search_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- Info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ℹ️ Penawaran ini akan dikirim ke penjual via notifikasi dan WhatsApp. Penjual bisa terima, tolak, atau balas penawaran."
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginBottom="12dp" />

</LinearLayout>
